# Credenciales. NUNCA se sube.
.env
*.key

# Entorno
.venv/
__pycache__/
*.py[cod]
.mypy_cache/
.ruff_cache/

# Salidas generadas: telemetria, WAV doblados, material del panel A/B.
out/*
!out/.gitkeep
# Excepcion: los factores de expansion medidos en F5 los lee config.py en runtime,
# y regenerarlos cuesta una cuota diaria entera de Groq (D30).
!out/expansion.json

# Fixtures de audio: se regeneran con los scripts de tests/. Pesan y no aportan al diff.
tests/fixtures/*.wav
