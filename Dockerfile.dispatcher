# SINCRO Engine v4 - Dispatcher (FastAPI HTTP)
#
# El Dispatcher maneja el contrato de conexion (seccion 4):
#   POST /v1/sessions   - crea una llamada, emite tokens
#   DELETE /v1/sessions/{id} - libera una sesion
#   POST /v1/voices     - enrola huella vocal
#   GET /v1/voices/{user_id} - consulta voces enroladas
#
# El Worker (call_serve.py) es OTRA Container App. El Dispatcher no
# maneja WebSockets de audio ni carga modelos ONNX.
#
# Build:
#   docker build -f Dockerfile.dispatcher -t sincro-dispatcher .
#
# Run local:
#   docker run --rm -p 8000:8000 --env-file .env sincro-dispatcher

FROM python:3.13-slim AS base

# ---- capa de build ----
FROM base AS builder

COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

WORKDIR /app

COPY pyproject.toml .
COPY src/sincro/__init__.py src/sincro/__init__.py

RUN uv venv /opt/venv && \
    uv pip install --python /opt/venv/bin/python -e ".[dev]"

# ---- capa final ----
FROM base AS final

WORKDIR /app

COPY --from=builder /opt/venv /opt/venv
COPY src/ src/
COPY pyproject.toml .

RUN /opt/venv/bin/pip install -e ".[dev]" --no-deps

ENV PATH="/opt/venv/bin:$PATH"
ENV PYTHONUNBUFFERED=1

EXPOSE 8000

HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health')" || exit 1

CMD ["python", "-m", "sincro.dispatcher", "--host", "0.0.0.0", "--port", "8000"]