# Credenciales. make check valida las tres con una llamada minima de solo lectura.
# Deepgram : https://console.deepgram.com  -> API Keys
# Groq     : https://console.groq.com/keys
# Fish     : https://fish.audio/go-api/    -> API Keys
DEEPGRAM_API_KEY=
GROQ_API_KEY=
FISH_API_KEY=

# Idiomas declarados. Sin autodeteccion, sin language=multi.
# Valores validos: es | en | pt-BR | fr | ja
SINCRO_SRC_LANG=es
SINCRO_DST_LANG=en


# Groq retiro llama-3.3-70b-versatile el 17/06/2026 y dejo de servirlo en agosto de
# 2026. Ver D8 en DECISIONS.md.
# R8/D43: qwen3.6-27b es tier Preview en Groq, no apto para produccion. v4 despliega
# infraestructura real: se usa gpt-oss-120b (tier Production), que ya paso el gate de
# tokens con reasoning_effort=low y cuesta menos por token de salida.
SINCRO_LLM_MODEL=openai/gpt-oss-120b
SINCRO_LLM_REASONING_EFFORT=low
SINCRO_LLM_TEMPERATURE=0.2
# 800, no 200: con presupuesto de bytes ajustado este modelo gasta 300-400+ tokens de
# razonamiento invisible antes de escribir la traduccion visible. Con 200 el segmento
# sale vacio (measured). Ver D43 -- el gate de <100 tokens/clausula de D8 NO se cumple
# con este modelo, es una excepcion consciente, no un exito.
SINCRO_LLM_MAX_TOKENS=800

SINCRO_TTS_MODEL=s2.1-pro-free     # dev; s2.1-pro para demo
# reference_id devuelto por make enroll. Vacio = voz neutra por defecto.
SINCRO_VOICE_ID=
SINCRO_VOICE_REF=tests/fixtures/voz_referencia.wav
SINCRO_LOG_LEVEL=INFO

# G2: secreto compartido para firmar/validar los tokens de sesion (contrato, seccion 8).
# Dispatcher y Worker son procesos distintos en produccion (Container Apps separadas);
# generar uno propio por entorno, nunca reusar el mismo valor en dev y produccion.
SINCRO_TOKEN_SECRET=
